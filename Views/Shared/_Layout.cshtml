<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>HN - TP LOCAL</title>
        <link rel="stylesheet" href="~/resources/Index.css" />
    </head>

    <body>
        <header>
            <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
            <h1>@ViewData["Title"]</h1>
        </header>

        <nav>
            <ul>
            @if (bool.Parse(ViewData["Accueil"].ToString()))
            {
                <li><a href="/Home/Index">Accueil</a></li>
            }
            @if (bool.Parse(ViewData["IndexForm"].ToString()))
            {
                <li><a href="/Home/Index/Form">Remplir le formulaire</a></li>
            }
            @if (bool.Parse(ViewData["Avis"].ToString()))
            {
                <li><a href="/Home/Index/AvisList">Liste avis</a></li>
            }
            @if (bool.Parse(ViewData["Form"].ToString()))
            {
                <li><a href="/Home/Index/Form">Formulaire</a></li>
            }
            </ul>
        </nav>

        @RenderBody()
    </body>
</html>