@model List<TPLOCAL1.Models.Opinion>

@{
    ViewData["Title"] = "Liste des Avis";
}

<nav>
    <ul>
        <li><a href="/Home/Index">Accueil</a></li>
        <li><a href="/Home/Index/Form">Formulaire</a></li>
    </ul>
</nav>

<section>
    <div>
        <table>
            <caption>Liste</caption>
            <tr>
                <td>Nom</td>
                <td>Prénom</td>
                <td>Avis donné</td>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LastName</td>
                    <td>@item.FirstName</td>
                    <td>@item.OpinionGiven</td>
                </tr>
            }
        </table>
    </div>
</section>
