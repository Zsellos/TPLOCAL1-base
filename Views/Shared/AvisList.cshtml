@model List<TPLOCAL1.Models.Opinion>

@{
    ViewData["Title"] = "Liste des Avis";

    ViewData["Accueil"] = "true";
    ViewData["IndexForm"] = "false";
    ViewData["Avis"] = "false";
    ViewData["Form"] = "true";
}

<section>
    <div>
        <table>
            <caption>Liste</caption>
            <tr>
                <td>Nom</td>
                <td>Prénom</td>
                <td>Avis donné</td>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LastName</td>
                    <td>@item.FirstName</td>
                    @if (item.OpinionGiven == "O")
                    {
                        <td class="yes">Oui</td>
                    }
                    else if (item.OpinionGiven == "N")
                    {
                        <td class="non">Non</td>
                    }
                    else
                    {
                        <td>@item.OpinionGiven</td>
                    }
                </tr>
            }
        </table>
    </div>
</section>
