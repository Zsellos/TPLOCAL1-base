@model TPLOCAL1.Models.Information

@{
    ViewData["Title"] = "Page de Validation";
}

<nav>
    <ul>
        <li><a href="/Home/Index">Accueil</a></li>
        <li><a href="/Home/Index/AvisList">Liste avis</a></li>
    </ul>
</nav>

<section>
    <div>
        <p>Votre formulaire a bien été pris en compte</p>
            <table>
                <caption>Personal informations</caption>
                <tr>
                    <td>Name</td>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <td>Forename</td>
                    <td>@Model.Forename</td>
                </tr>
                <tr>
                    <td>Gender</td>
                    <td>@Model.Gender</td>
                </tr>
                <tr>
                    <td>Address</td>
                    <td>@Model.Address</td>
                </tr>
                <tr>
                    <td>Zip Code</td>
                    <td>@Model.ZipCode</td>
                </tr>
                <tr>
                    <td>Town</td>
                    <td>@Model.Town</td>
                </tr>
                <tr>
                    <td>Email Adress</td>
                    <td>@Model.Email</td>
                </tr>
            </table>

            <table>
                <caption>Training information</caption>
                <tr>
                    <td>Start date training</td>
                    <td>@Model.StartDate</td> @*TODO: Make sure date is dd/mm/yyyy*@
                </tr>
                <tr>
                    <td>Type of training</td>
                    <td>@Model.TypeTraining</td>
                </tr>
            </table>

            <table>
                <caption>Training reviews</caption>
                <tr>
                    <td>Cobol Formation</td>
                    <td>@Model.ReviewCobol</td>
                </tr>
                <tr>
                    <td>C# Formation</td>
                    <td>@Model.ReviewCSharp</td>
                </tr>
            </table>
    </div>
</section>