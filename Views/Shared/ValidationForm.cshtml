@model TPLOCAL1.Models.Information

@{
    ViewData["Title"] = "Page de Validation";
}

<nav>
    <ul>
        <li><a href="/Home/Index">Accueil</a></li>
        <li><a href="/Home/Index/AvisList">Liste avis</a></li>
    </ul>
</nav>

<section>
    <div>
        <p>Votre formulaire a bien été pris en compte</p>
            <table>
                <caption>Informations personnelles</caption>
                <tr>
                    <td>Nom</td>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <td>Prénom</td>
                    <td>@Model.Forename</td>
                </tr>
                <tr>
                    <td>Sexe</td>
                    <td>@Model.Gender</td>
                </tr>
                <tr>
                    <td>Addresse</td>
                    <td>@Model.Address</td>
                </tr>
                <tr>
                    <td>Code Postal</td>
                    <td>@Model.ZipCode</td>
                </tr>
                <tr>
                    <td>Ville</td>
                    <td>@Model.Town</td>
                </tr>
                <tr>
                    <td>Addresse mail</td>
                    <td>@Model.Email</td>
                </tr>
            </table>

            <table>
                <caption>Informations formation suivie</caption>
                <tr>
                    <td>Date de début de formation</td>
                    <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <td>Formation suivie</td>
                    <td>@Model.TypeTraining</td>
                </tr>
            </table>

            <table>
            <caption>Avis sur la formation</caption>
                <tr>
                    <td>Formation Cobol</td>
                    <td>@Model.ReviewCobol</td>
                </tr>
                <tr>
                    <td>Formation C#</td>
                    <td>@Model.ReviewCSharp</td>
                </tr>
            </table>
    </div>
</section>