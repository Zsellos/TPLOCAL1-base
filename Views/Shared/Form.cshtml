@model TPLOCAL1.Models.Information

@{
    ViewData["Title"] = "Formulaire TP HN avis";
}
@* @Html.ValidationSummary(false, "") *@

<nav>
    <ul>
        <li><a href="/Home/Index">Accueil</a></li>
        <li><a href="/Home/Index/AvisList">Liste avis</a></li>
    </ul>
</nav>

<section>
<div>
        <form asp-action="ValidationFormulaire" method="post">
        <table>
            <caption>Information personnelles</caption>
            <tr>
                <td>Nom</td> 
                <td><input asp-for="Name" /> <span asp-validation-for="Name"></span></td>
            </tr>
            <tr>
                <td>Prénom</td>
                <td><input asp-for="Forename" /><span asp-validation-for="Forename"></span></td>
            </tr>
            <tr>
                <td>Sexe</td>
                <td>
                    <select asp-for="Gender">
                            <option value="">Sélectionner un sexe</option>
                            <option value="Homme">Homme</option>
                            <option value="Femme">Femme</option>
                            <option value="Autre">Autre</option>
                    </select>
                    <span asp-validation-for="Gender"></span>
                </td>
            </tr>                    
            <tr>
                <td>Addresse</td>
                <td><input asp-for="Address" /><span asp-validation-for="Address"></span></td>
            </tr>
            <tr>
                <td>Code Postal</td>
                <td><input asp-for="ZipCode" /><span asp-validation-for="ZipCode"></span></td>
            </tr>
            <tr>
                <td>Ville</td>
                <td><input asp-for="Town" /><span asp-validation-for="Town"></span></td>
            </tr>
            <tr>
                <td>Addresse mail</td>
                    <td><input asp-for="Email" /><span asp-validation-for="Email"></span></td>                
            </tr>
        </table>

        <table>
            <caption>Informations formation suivie</caption>
            <tr>
                <td>Date début formation</td>
                <td><input asp-for="StartDate" type="date"/><span asp-validation-for="StartDate"></span></td>
            </tr>
            <tr>
                <td>Formation suivie</td>
                <td>
                    <select asp-for="TypeTraining">
                        <option value="">Sélectionner une formation</option>
                        <option value="Formation Cobol">Formation Cobol</option>
                        <option value="Formation par objet">Formation par objet</option>
                        <option value="Formation à couuble compétence">Formation à double compétence</option>
                    </select>
                    <span asp-validation-for="TypeTraining"></span>
                </td>
                
            </tr>
        </table>

        <table>
            <caption>Avis sur la formation</caption>
            <tr>
                <td>Formation Cobol</td>
                <td><input asp-for="ReviewCobol"/><span asp-validation-for="ReviewCobol"></span></td>
            </tr>
            <tr>
                <td>Formation C#</td>
                <td><input asp-for="ReviewCSharp"/><span asp-validation-for="ReviewCSharp"></span></td>
            </tr>
        </table>
            <input type="submit" value="Valider" />
    </form>

    @* TODO: Add Layout to make the construction of pages easier
        Review HomeController and implement todo
        Should I do something about page url not being the right one when wrong form or for validation page ?
    *@
            
</div>
</section>