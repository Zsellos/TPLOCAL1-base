<!DOCTYPE html>
@model TPLOCAL1.Models.Information

<html>
    <head>
        <title>HN - TP LOCAL</title>
        <link rel="stylesheet" href="~/resources/Index.css" />
    </head>

    <body>
        <header>
            <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN"/>
            <h1>Formulaire TP HN avis</h1>
        </header>

        <nav>
            <ul>
                <li><a href="/Home/Index">Accueil</a></li>
                <li><a href="/Home/Index/AvisList">Liste avis</a></li>
            </ul>
        </nav>

        <section>
        <div>
            <form method="post">
                @* asp-controller="HomeController" asp-action="ValidationFormulaire" *@
                <table>
                    <caption>Personal informations</caption>
                    <tr>
                        <td>Name</td> 
                        @* @Html.DisplayNameFor(model => model.Name)</td> *@
                        <td><input asp-for="Name" /></td>
                    </tr>
                    <tr>
                        <td>Forename</td>
                            @* @Html.DisplayNameFor(model => model.Forename)</td> *@
                        <td><input asp-for="Forename" /></td>
                    </tr>
                    <tr>
                        <td>Gender</td>
                        @* @Html.DisplayFor(model => model.Gender)</td> *@
                        <td><select asp-for="Gender" name="genders" id="genders">
                            <option value="select">Select a gender</option>
                            <option value="man">Man</option>
                            <option value="women">Woman</option>
                            <option value="other">Other</option>
                            </select>
                        </td>
                    </tr>                    
                    <tr>
                        <td>Adress</td>
                        @* @Html.DisplayNameFor(model => model.Address)</td> *@
                        <td><input asp-for="Address" /></td>
                    </tr>
                    <tr>
                        <td>Zip Code</td>
                        @* @Html.DisplayFor(model => model.ZipCode)</td> *@
                        <td><input asp-for="ZipCode" /></td>
                    </tr>
                    <tr>
                        <td>Town</td>
                        @* @Html.DisplayNameFor(model => model.Town)</td> *@
                        <td><input asp-for="Town" /></td>
                    </tr>
                    <tr>
                        <td>Email Adress</td>
                        @* @Html.DisplayFor(model => model.Email)</td> *@
                        <td><input asp-for="Email" /></td>
                    </tr>
                </table>

                <table>
                    <caption>Training information</caption>
                    <tr>
                        <td>Start date training</td>
                        <td><input asp-for="StartDate" type="date" /></td>
                    </tr>
                    <tr>
                        <td>Type of training</td>
                        <td>
                            <select asp-for="TypeTraining" name="training" id="training">
                                <option value="select_training">Select a training</option>
                                <option value="cobol">Cobol training</option>
                                <option value="object">Object training</option>
                                <option value="dual_skills">Dual Skills training</option>
                            </select>
                        </td>
                    </tr>
                </table>

                <table>
                    <caption>Training reviews</caption>
                    <tr>
                        <td>Cobol Formation</td>
                        <td><input asp-for="ReviewCobol" /></td>
                    </tr>
                    <tr>
                        <td>C# Formation</td>
                        <td><input asp-for="ReviewCSharp" /></td>
                    </tr>
                </table>

                <input asp-route="ValidationForm" type="submit" value="Validate" />
            </form>

            @* TODO: Search why it doesn't display the valisation form page
                Keep implementing validation
                Does data need to be saved since we don't have a database ?
                Search how to display data for "list des avis" (linked to xml file ?)
                Add Layout to make the construction of pages easier
                Review HomeController and implement todo
                https://learn.microsoft.com/en-gb/aspnet/core/tutorials/first-mvc-app/controller-methods-views?view=aspnetcore-10.0
                https://learn.microsoft.com/en-gb/aspnet/core/mvc/views/working-with-forms?view=aspnetcore-10.0
                https://learn.microsoft.com/en-us/aspnet/core/mvc/views/working-with-forms?view=aspnetcore-10.0
                '
            ' *@
            
        </div>
        </section>
    </body>
</html>