@model TPLOCAL1.Models.Information

@{
    ViewData["Title"] = "Formulaire TP HN avis";

    ViewData["Accueil"] = "true";
    ViewData["IndexForm"] = "false";
    ViewData["Avis"] = "true";
    ViewData["Form"] = "false";
}
@* @Html.ValidationSummary(false, "") *@

<section>
<div>
        <form asp-action="ValidationFormulaire" method="post">
        <table>
            <caption>Information personnelles</caption>
            <tr>
                <td>Nom</td> 
                <td><input asp-for="Name"/> <span class="error" asp-validation-for="Name"></span></td>
            </tr>
            <tr>
                <td>Prénom</td>
                <td><input asp-for="Forename" /><span class="error" asp-validation-for="Forename"></span></td>
            </tr>
            <tr>
                <td>Sexe</td>
                <td>
                    <select asp-for="Gender">
                            <option value="">Sélectionner un sexe</option>
                            <option value="Homme">Homme</option>
                            <option value="Femme">Femme</option>
                            <option value="Autre">Autre</option>
                    </select>
                    <span class="error" asp-validation-for="Gender"></span>
                </td>
            </tr>                    
            <tr>
                <td>Addresse</td>
                <td><input asp-for="Address" /><span class="error" asp-validation-for="Address"></span></td>
            </tr>
            <tr>
                <td>Code Postal</td>
                <td><input asp-for="ZipCode" /><span class="error" asp-validation-for="ZipCode"></span></td>
            </tr>
            <tr>
                <td>Ville</td>
                <td><input asp-for="Town" /><span class="error" asp-validation-for="Town"></span></td>
            </tr>
            <tr>
                <td>Addresse mail</td>
                    <td><input asp-for="Email" /><span class="error" asp-validation-for="Email"></span></td>                
            </tr>
        </table>

        <table>
            <caption>Informations formation suivie</caption>
            <tr>
                <td>Date début formation</td>
                <td><input asp-for="StartDate" type="date"/><span class="error" asp-validation-for="StartDate"></span></td>
            </tr>
            <tr>
                <td>Formation suivie</td>
                <td>
                    <select asp-for="TypeTraining">
                        <option value="">Sélectionner une formation</option>
                        <option value="Formation Cobol">Formation Cobol</option>
                        <option value="Formation par objet">Formation par objet</option>
                        <option value="Formation à couuble compétence">Formation à double compétence</option>
                    </select>
                    <span class="error" asp-validation-for="TypeTraining"></span>
                </td>
                
            </tr>
        </table>

        <table>
            <caption>Avis sur la formation</caption>
            <tr>
                <td>Formation Cobol</td>
                <td><input asp-for="ReviewCobol"/><span class="error" asp-validation-for="ReviewCobol"></span></td>
            </tr>
            <tr>
                <td>Formation C#</td>
                <td><input asp-for="ReviewCSharp"/><span class="error" asp-validation-for="ReviewCSharp"></span></td>
            </tr>
        </table>
            <input type="submit" value="Valider" />
    </form>            
</div>
</section>