@model TPLOCAL1.Models.Information

@{
    ViewData["Title"] = "Formulaire TP HN avis";
}
@* @Html.ValidationSummary(false, "") *@

<nav>
    <ul>
        <li><a href="/Home/Index">Accueil</a></li>
        <li><a href="/Home/Index/AvisList">Liste avis</a></li>
    </ul>
</nav>

<section>
<div>
        <form asp-action="ValidationFormulaire" method="post">
        <table>
            <caption>Personal informations</caption>
            <tr>
                <td>Name</td> 
                <td><input asp-for="Name" /></td>
                <span asp-validation-for="Name"></span>
            </tr>
            <tr>
                <td>Forename</td>
                <td><input asp-for="Forename" /></td>
                <span asp-validation-for="Forename"></span>
            </tr>
            <tr>
                <td>Gender</td>
                <td>
                    <select asp-for="Gender">
                            <option value="select">Select a gender</option>
                            <option value="man">Man</option>
                            <option value="women">Woman</option>
                            <option value="other">Other</option>
                    </select>
                </td>
                <span asp-validation-for="Gender"></span>
            </tr>                    
            <tr>
                <td>Address</td>
                <td><input asp-for="Address" /></td>
                <span asp-validation-for="Address"></span>
            </tr>
            <tr>
                <td>Zip Code</td>
                <td><input asp-for="ZipCode" /></td>
                <span asp-validation-for="ZipCode"></span>
            </tr>
            <tr>
                <td>Town</td>
                <td><input asp-for="Town" /></td>
                <span asp-validation-for="Town"></span>
            </tr>
            <tr>
                <td>Email Adress</td>
                <td><input asp-for="Email" /></td>
                <span asp-validation-for="Email"></span>
            </tr>
        </table>

        <table>
            <caption>Training information</caption>
            <tr>
                <td>Start date training</td>
                <td><input asp-for="StartDate" type="date" /></td>
                <span asp-validation-for="StartDate"></span>
            </tr>
            <tr>
                <td>Type of training</td>
                <td>
                        <select asp-for="TypeTraining">
                        <option value="select_training">Select a training</option>
                        <option value="cobol">Cobol training</option>
                        <option value="object">Object training</option>
                        <option value="dual_skills">Dual Skills training</option>
                    </select>
                </td>
                <span asp-validation-for="Name"></span>
            </tr>
        </table>

        <table>
            <caption>Training reviews</caption>
            <tr>
                <td>Cobol Formation</td>
                <td><input asp-for="ReviewCobol" /></td>
                <span asp-validation-for="ReviewCobol"></span>
            </tr>
            <tr>
                <td>C# Formation</td>
                <td><input asp-for="ReviewCSharp" /></td>
                <span asp-validation-for="ReviewCSharp"></span>
            </tr>
        </table>
            <input type="submit" value="Validate" />
    </form>

    @* TODO: Search how to display data for "list des avis" (linked to xml file ?)
        Add Layout to make the construction of pages easier
        Review HomeController and implement todo
        Should I do something about page url not being the right one when wrong form or for validation page ?
    *@
            
</div>
</section>